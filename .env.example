# Copie para .env e preencha com suas credenciais (nunca commite o .env!)
GROQ_API_KEY=gsk_your_key_here

# Chave da API Anthropic — usada pelo claude_review.py no pre-push
# Sem ela, a revisão semântica é ignorada (sem bloqueio de push)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Modelo padrão para classificações (gratuito via Groq)
LLM_MODEL=llama3-8b-8192

# Caminho para o dataset (CSV ou JSON mined-comments)
DATASET_PATH=data/github_prs.csv

# Backend LLM: groq (padrão, requer GROQ_API_KEY) | ollama (local, sem API key)
LLM_BACKEND=groq

# Host do Ollama — use http://host.docker.internal:11434 quando rodar via Docker
OLLAMA_HOST=http://localhost:11434

# Tamanho máximo do cache LRU para classificações LLM
LLM_CACHE_SIZE=1024

# ── Otimizações de throughput ─────────────────────────────────────────────────

# Número de threads paralelas para classificação (1 = serial/lazy, padrão)
# Com 4 workers e qwen2:1.5b: ~2000 PRs em ~25 min vs ~5h sequencial
# "auto" detecta CPU/RAM/GPU e calcula o valor ideal automaticamente
# Número fixo (ex: 4) sobrescreve a detecção automática
LLM_MAX_WORKERS=auto

# Habilita tool calling: 1 chamada LLM por PR em vez de 3 (padrão: false)
# Requer modelo com suporte a tools: qwen2:1.5b, phi3:mini, llama3.1, llama3.2
# Com tinyllama (sem suporte a tools) mantenha false
# ollama pull qwen2:1.5b   ← modelo recomendado para tool calling + velocidade
LLM_USE_TOOLS=false

# PRs por chamada LLM em modo tools (1 = individual, 5–10 = batch)
# Batch reduz chamadas: 2000 PRs ÷ 5 = 400 chamadas em vez de 2000
# Requer modelo com tool calling. qwen2:1.5b suporta bem até batch_size=5
# Valores maiores (10+) podem falhar em modelos pequenos — use fallback automático
LLM_BATCH_SIZE=1
