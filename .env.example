# Copie este arquivo para .env e ajuste apenas o necessário.
# Nunca versione o arquivo .env nem credenciais reais.

# Backend de classificação: groq (nuvem) ou ollama (local)
LLM_BACKEND=groq

# Obrigatória somente quando LLM_BACKEND=groq
GROQ_API_KEY=gsk_your_key_here

# Modelo usado pelo backend selecionado
LLM_MODEL=llama3-8b-8192

# Use http://host.docker.internal:11434 ao executar Ollama via Docker
OLLAMA_HOST=http://localhost:11434

# Concorrência e batching. "auto" usa a detecção local de hardware.
LLM_MAX_WORKERS=auto
LLM_USE_TOOLS=false
LLM_BATCH_SIZE=1

# Política de retry do cliente LLM
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0

# Limites de texto enviados ao modelo
LLM_BODY_CHARS_SINGLE=400
LLM_BODY_CHARS_BATCH=100

# Pipeline configurável por ambiente
FILTER_STATE=
MIN_CHANGES=0
ENABLE_LLM=false

# CLI e upload da interface
DATASET_PATH=data/github_prs.csv
MAX_UPLOAD_SIZE_MB=10240
